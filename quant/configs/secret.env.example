# 凭证模板 — 复制为 secret.env 后填入，切勿提交 git
# cp configs/secret.env.example configs/secret.env

# 闲时 LLM（北京时间非高峰；舆情记忆 / 因子实验室 / TA 否决）
# 纯本地 Ollama 可不填；填了才会在高峰失败时回落云端
# LLM_API_KEY=sk-your-key-here
# LLM_MODEL=deepseek-v4-flash
# LLM_BASE_URL=https://api.deepseek.com
# 可选：舆情记忆闲时单独覆盖（默认回落上面的 LLM_*）
# LLM_OFFPEAK_MODEL=deepseek-v4-flash
# LLM_OFFPEAK_BASE_URL=https://api.deepseek.com
# LLM_OFFPEAK_API_KEY=

# 高峰时段自部署（北京时间 9:00–12:00、14:00–18:00）
# 本地 Ollama 无需 key（可留空）。URL 含 ollama / :11434（或 LLM_PEAK_BACKEND=ollama）
# 时走原生 /api/chat 并 think=False；其它走 OpenAI 兼容 /v1。
# 本机原生默认 11434；8001/ollama/v1 是带反代的网关。
# 未配 LLM_API_KEY 时不会回落 DeepSeek，闲时也继续走本地。
# LLM_PEAK_API_KEY=
LLM_PEAK_BASE_URL=http://127.0.0.1:11434
LLM_PEAK_MODEL=nemotron-3.5-lightning:30b-a3b-mlx-bf16
LLM_PEAK_BACKEND=ollama
# LLM_PEAK_THINK=false
# 反代示例：LLM_PEAK_BASE_URL=http://127.0.0.1:8001/ollama/v1

# Quant Agent Supervisor：始终优先 LLM_PEAK_*（不按时段）；高峰失败默认回落闲时
# AGENT_LLM_PEAK_ONLY=1   # 设为 1 则禁止回落 DeepSeek

# Agent API 鉴权升级（可选）
# AGENT_API_TOKEN=change-me          # 配置后可用 Authorization: Bearer 绕过/补充 IP 白名单
# AGENT_API_TOKEN_STRICT=1           # 设为 1 时，白名单 IP 的写操作也必须带 Bearer
# AGENT_USE_LANGGRAPH=1              # Supervisor 走 LangGraph（默认开）

# Cursor Agent SDK（实盘舆情硬伤筛）
# 密钥：https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
CURSOR_AGENT_MODEL=composer-2.5
# local | cloud（推荐 local；cloud 看不到 gitignore 的 data/ 订单）
CURSOR_AGENT_RUNTIME=local

# MinIO 数据同步（服务器 push / 本地 pull）
# MINIO_ENDPOINT=118.195.177.58:9000   # 服务器内网可用 10.10.0.5:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your-minio-secret
